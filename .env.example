# Backend API base (existing)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Organic Mitra chatbot endpoint (defaults to ${NEXT_PUBLIC_API_URL}/chat)
NEXT_PUBLIC_CHAT_API_URL=http://localhost:5000/api/chat

# Backend calls /api/revalidate with this secret after admin saves (must match backend)
REVALIDATE_SECRET=change-me
